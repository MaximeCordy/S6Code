{
  "name": "galerie-des-souvenirs",
  "version": "1.0.0",
  "description": "La Galerie des Souvenirs — musée interactif sur William Utermohlen et la maladie d'Alzheimer (Eikon, S6)",
  "scripts": {
    "clean:output": "rimraf dist",
    "clean:cache": "rimraf .parcel-cache",
    "dev": "npm run i18n && npm run clean:cache && parcel \"src/*.html\" \"src/en/*.html\" --dist-dir .dev-dist",
    "build": "npm run i18n:check && npm run clean:output && parcel build \"src/*.html\" \"src/en/*.html\" --public-url / --no-cache --no-source-maps",
    "postbuild": "cp -R public/. dist/",
    "preview": "npx --yes serve dist -l 4173",
    "i18n": "node scripts/build-i18n.mjs",
    "i18n:check": "node scripts/build-i18n.mjs --strict"
  },
  "author": "Maxime Cordy",
  "license": "ISC",
  "parcel-namer-rewrite": {
    "rules": {
      "(.*)\\.(css)": "css/$1{.hash}.$2",
      "(.*)\\.(js)": "js/$1{.hash}.$2",
      "(.*)\\.(woff|woff2?)": "fonts/$1.$2",
      "(.*)\\.(mp3)": "audio/$1.$2",
      "(.*)\\.(mp4|ogg|webm)": "video/$1.$2",
      "(.*)\\.(svg|png|gif|jpg|webp)": "img/$1{.hash}.$2"
    },
    "silent": true,
    "development": {
      "disable": false
    }
  },
  "devDependencies": {
    "node-html-parser": "^9.0.7",
    "parcel": "^2.12.0",
    "parcel-namer-rewrite": "^2.10.3-rc.2",
    "posthtml-extend": "^0.6.5",
    "posthtml-include": "^2.0.1",
    "posthtml-inline-svg": "^0.2.0",
    "rimraf": "^6.0.1",
    "sass": "^1.69.5"
  },
  "dependencies": {
    "@barba/core": "^2.10.3",
    "@fontsource/poppins": "^5.3.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.25"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximeCordy/S6Code.git"
  }
}
